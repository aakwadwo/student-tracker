# Copy to .env and replace the placeholders. Never commit .env.
# Required: secret used to sign and verify JWT access tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-string

# Database connection. Use host "db" and port 3306 when running with docker-compose.
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/student_tracker
